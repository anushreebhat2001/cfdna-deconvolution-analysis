248:    return parsed_header
251:def get_header(sample, num_samples, num_unk):
255:    sample: dataframe of input data- with header
260:    header = list(sample)
262:    samples = parse_header_names(
263:        header[3 : (num_samples * 2) + 3]
264:    )  # samples are first part of header
265:    tissues = parse_header_names(
266:        header[(num_samples * 2) + 3 + 3 :]
267:    )  # tissues are second part of header
